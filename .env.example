# 大模型（OpenAI 兼容协议）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
APP_API_KEY=

# Tavily 联网搜索
TAVILY_API_KEY=

# 高德 Web 服务 API Key（可选；用于核验地点和步行/公交耗时）
AMAP_WEB_KEY=

# 内部知识库（本地向量检索）
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_MODEL_PATH=
KNOWLEDGE_BASE_DIR=./knowledge_base
# 向量索引固定保存在 storage/vector_index.npz

# 数据库
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=travel_kb
MYSQL_CHARSET=utf8mb4

# 检索
RETRIEVE_TOP_K=5
RETRIEVE_MIN_SCORE=0.45
